# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Storage Buckets
PROJECT_IMAGES_BUCKET=project-images
CERTIFICATE_IMAGES_BUCKET=certificate-images
PROFILE_IMAGES_BUCKET=profile-images

# Contact Form Configuration
CONTACT_FORM_ENDPOINT=https://your-api-endpoint.com/contact

# Application Environment
APP_ENV=production
APP_NAME=Youssef Hassan Portfolio
APP_URL=https://youssefsalem582.github.io/Personal-Portfolio/

# Social Media Links
GITHUB_URL=https://github.com/YoussefSalem582
