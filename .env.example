# Optional environment variables for local optimized builds (scripts only).
# Flutter does not load this file. Export in your shell, or pass --dart-define on flutter commands.
# See: tech_readme_files/04_Contact_And_Deploy/CONTACT_FORM.md
#
# PowerShell example:
#   $env:FORMSPREE_ENDPOINT = "https://formspree.io/f/your_form_id"
#   $env:CONTACT_RECIPIENT_EMAIL = "you@example.com"
#   .\scripts\build_optimized.ps1
#
# Bash example:
#   export FORMSPREE_ENDPOINT="https://formspree.io/f/your_form_id"
#   export CONTACT_RECIPIENT_EMAIL="you@example.com"
#   ./scripts/build_optimized.sh
#
# FORMSPREE_ENDPOINT=
# CONTACT_RECIPIENT_EMAIL=
